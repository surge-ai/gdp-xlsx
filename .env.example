# GDP.xlsx Gemini judge: pass this key with --ve GEMINI_API_KEY="$GEMINI_API_KEY".
# A Gemini model under evaluation uses the same key.
GEMINI_API_KEY=

# Hostname of the evaluated model's API or proxy (no scheme or path).
# Pass with --allow-agent-host; repeat the flag for additional API hosts.
LLM_HOST=api.provider.com

# Credentials for the model under evaluation. Keep only the providers you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_API_BASE=
# OPENROUTER_API_KEY=
